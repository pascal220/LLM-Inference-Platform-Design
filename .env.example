# Redis
REDIS_URL=redis://redis:6379

# Service URLs (used when running locally without Docker)
INFERENCE_GATEWAY_URL=http://localhost:8001
CONTROL_PLANE_URL=http://localhost:8003

# Worker config
USE_MOCK=true
WORKER_ID=worker-1

# Optional: vLLM model path (only needed when USE_MOCK=false)
MODEL_PATH=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Optional: Logging level
LOG_LEVEL=INFO